# ===== 知修 Zhixiu 环境配置示例（复制为 .env，勿提交真实密钥）=====

# --- 数据库 ---
# 本地可使用 SQLite；PostgreSQL Compose 覆盖此配置。
DATABASE_URL=sqlite:///./zhixiu_dev.db
# PostgreSQL / 华为云 RDS：
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<rds-host>:5432/zhixiu

# --- Redis（限流/缓存，非业务事实库）---
REDIS_URL=
# 可配置 Redis；不可用时限流退回数据库，不影响预约容量事实。

# --- 会话与安全 ---
# 生产环境务必更换为足够长的随机串
SECRET_KEY=dev-only-change-me-please-32bytes-min
SESSION_TTL_HOURS=72
# 允许的前端来源（逗号分隔），本地 Vite 开发默认 5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Cookie 是否仅走 HTTPS（生产为 true）
COOKIE_SECURE=false

# --- 华为云 MaaS 模型适配层（可选；未配置时诊断引擎以规则/审核流程运行）---
MODEL_PROVIDER=openai-compatible
MAAS_ENABLED=false
MAAS_BASE_URL=
MAAS_API_KEY=
MAAS_CHAT_MODEL=
MAAS_EMBEDDING_MODEL=
MAAS_RERANK_MODEL=
# DeepSeek 示例（密钥只填本地 .env）：
# MODEL_PROVIDER=deepseek
# MAAS_BASE_URL=https://api.deepseek.com
# MAAS_CHAT_MODEL=deepseek-flash

# --- 私有图片：本地目录或 OBS 的 S3 兼容端点 ---
UPLOAD_DIR=./uploads
OBS_ENABLED=false
OBS_BUCKET=
OBS_ENDPOINT=
OBS_AK=
OBS_SK=

# --- 邮箱验证与可选邮件任务 ---
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- 运行 ---
APP_ENV=dev
# 启动时自动建表并写入演示种子数据（仅开发/演示环境）
AUTO_SEED=true
